{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brcampidelli/chimera-connectors/schema/connector.schema.json",
  "title": "Chimera connector",
  "description": "One connector (MCP server or OpenAPI API). Never contains a secret value: only environment variable NAMES.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "vendor", "kind", "official", "evidence", "homepage", "docs", "status",
    "transport", "auth", "license", "capability", "default_mode", "default_mode_notes",
    "categories", "tags", "logo", "stars", "notes"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 60},
    "vendor": {"type": "string", "minLength": 1, "maxLength": 80},
    "kind": {"enum": ["mcp", "openapi"]},
    "official": {"type": "boolean", "description": "Selo 'Oficial do fornecedor'. Só true com evidência em fonte primária no domínio registrável do fornecedor."},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "checked_at", "method", "vendor_domains"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "extra_urls": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
        "checked_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "method": {"enum": ["vendor-docs", "vendor-repo", "registry-domain", "none"]},
        "vendor_domains": {
          "type": "array",
          "description": "Domínios REGISTRÁVEIS do fornecedor (nunca um sufixo público como vercel.app).",
          "items": {"type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"}
        },
        "vendor_github_orgs": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"}},
        "oauth_probe": {
          "type": "string",
          "description": "O que a descoberta OAuth (RFC 9728/8414) do endpoint mostrou na data da checagem."
        }
      }
    },
    "homepage": {"type": "string", "pattern": "^https://"},
    "docs": {"type": "string", "pattern": "^https://"},
    "status": {"enum": ["ga", "beta", "preview", "deprecated", "unknown"]},
    "transport": {"enum": ["stdio", "http"]},
    "stdio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "package", "version", "args"],
      "properties": {
        "runner": {"enum": ["npx", "uvx", "docker", "binary"]},
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "command": {"type": "string"},
        "args": {"type": "array", "items": {"type": "string"}},
        "env_fixed": {
          "type": "object",
          "description": "Valores fixos NÃO secretos escolhidos pelo catálogo (ex.: GITHUB_READ_ONLY=1).",
          "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]*$"},
          "additionalProperties": {"type": "string", "maxLength": 200}
        },
        "params": {
          "type": "array",
          "description": "Valores que o dono informa na instalação (ex.: uma pasta). Não são segredos.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "hint"],
            "properties": {"name": {"type": "string", "pattern": "^[a-z_]+$"}, "hint": {"type": "string"}}
          }
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "alternate_urls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "why"],
            "properties": {"url": {"type": "string", "pattern": "^https://"}, "why": {"type": "string"}}
          }
        }
      }
    },
    "openapi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_name", "spec_url", "spec_license", "base_url", "key_in", "key_name", "key_prefix"],
      "properties": {
        "connector_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$"},
        "spec_url": {"type": ["string", "null"], "pattern": "^https://"},
        "spec_license": {"type": ["string", "null"]},
        "base_url": {"type": "string", "pattern": "^https://"},
        "key_in": {"enum": ["header", "query"]},
        "key_name": {"type": "string"},
        "key_prefix": {"type": "string"}
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "dcr_supported", "client_restriction", "env", "notes"],
      "properties": {
        "method": {"enum": ["oauth", "api_key", "none"]},
        "alt_methods": {"type": "array", "items": {"enum": ["oauth", "api_key", "none", "login"]}},
        "dcr_supported": {"enum": [true, false, "unknown"]},
        "client_restriction": {"enum": ["none", "allowlist", "own_app", "tenant", "unknown"]},
        "env": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}, "uniqueItems": true},
        "notes": {"type": "string"}
      }
    },
    "license": {
      "type": ["string", "null"],
      "description": "SPDX do código do servidor quando aberto; null quando o servidor é hospedado e fechado."
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "executes", "money"],
      "properties": {
        "read": {"type": "boolean"},
        "write": {"type": "boolean"},
        "executes": {"type": "boolean"},
        "money": {"type": "boolean"}
      }
    },
    "default_mode": {
      "enum": ["read_only", "scoped", "full"],
      "description": "read_only = imposto pelo fornecedor; scoped = estreitado por mecanismo do fornecedor (escopo, skill, permissão da chave) sem garantir só leitura; full = o fornecedor não oferece estreitamento."
    },
    "default_mode_notes": {"type": "string", "minLength": 1},
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"type": "string"},
        "secondary": {"type": "array", "items": {"type": "string"}, "maxItems": 3, "uniqueItems": true}
      }
    },
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "uniqueItems": true},
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url_if_allowed", "decision"],
      "properties": {
        "source": {"enum": ["brand_kit", "monogram"]},
        "url_if_allowed": {"type": ["string", "null"], "pattern": "^https://"},
        "decision": {"type": "string", "minLength": 1}
      }
    },
    "stars": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["repo", "count", "checked_at"],
      "properties": {
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"},
        "count": {"type": "integer", "minimum": 0},
        "checked_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "notes": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"transport": {"const": "stdio"}}}, "then": {"required": ["stdio"], "not": {"required": ["http"]}}},
    {"if": {"properties": {"transport": {"const": "http"}, "kind": {"const": "mcp"}}}, "then": {"required": ["http"], "not": {"required": ["stdio"]}}},
    {"if": {"properties": {"kind": {"const": "openapi"}}}, "then": {"required": ["openapi"], "properties": {"transport": {"const": "http"}}}},
    {"if": {"properties": {"kind": {"const": "mcp"}}}, "then": {"not": {"required": ["openapi"]}}},
    {"if": {"properties": {"official": {"const": true}}}, "then": {"properties": {"evidence": {"properties": {"method": {"not": {"const": "none"}}}}}}},
    {"if": {"properties": {"logo": {"properties": {"source": {"const": "monogram"}}}}}, "then": {"properties": {"logo": {"properties": {"url_if_allowed": {"const": null}}}}}}
  ]
}
